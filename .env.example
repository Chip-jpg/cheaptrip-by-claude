# ============================================================
# Travel Deal Intelligence Engine — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Anthropic (AI formatting layer) ---
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Skyscanner RapidAPI ---
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_SKYSCANNER_HOST=skyscanner50.p.rapidapi.com
# Check the "Endpoints" tab in your RapidAPI console if you get 404s from Skyscanner
RAPIDAPI_SKYSCANNER_ENDPOINT=/api/v1/searchFlights

# --- Currency Exchange API ---
# Free tier: https://exchangerate-api.com
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/travel_deals.db

# --- Scheduler ---
SCRAPE_INTERVAL_MINUTES=90
DIGEST_HOUR=8
DIGEST_MINUTE=0

# --- Alert Thresholds ---
EUROPE_TRIP_MAX_EUR=120
LONGHAUL_TRIP_MAX_EUR=450
HOTEL_DISCOUNT_MIN_PCT=60
FLIGHT_DISCOUNT_MIN_PCT=60
INSTANT_ALERTS_PER_HOUR=5

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/engine.log
